[Unit]
Description=mem0-service - LAN shared long-term memory (mem0 + pgvector + local embedder)
Documentation=file://%h/mem0-service/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 密钥全部来自 %h/mem0-service/.env（chmod 600），本 unit 不放任何密钥
WorkingDirectory=%h/mem0-service
Environment=HOME=%h
Environment=PYTHONUNBUFFERED=1
Environment=HF_ENDPOINT=https://hf-mirror.com
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=%h/mem0-service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 18810
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
