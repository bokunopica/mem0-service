# mem0-service 环境变量示例：复制成 .env 再填真实值，然后 chmod 600 .env
# cp .env.example .env && chmod 600 .env

# --- 服务自身 ---
# 客户端鉴权 key（Hermes 插件 / Windows 客户端都带这个）。随便生成一个长随机串：
#   python3 -c "import secrets; print('mem0-' + secrets.token_urlsafe(32))"
MEM0_SERVICE_KEY=change-me-service-key
MCP_HOST=127.0.0.1
MCP_PORT=18810

# --- LLM：记忆抽取用（任意 OpenAI 兼容接口） ---
MEM0_LLM_API_KEY=change-me-llm-api-key
MEM0_LLM_BASE_URL=https://api.deepseek.com
MEM0_LLM_MODEL=deepseek-chat

# --- Embedder：本地 huggingface 模型 ---
MEM0_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
MEM0_EMBED_DIMS=1024
MEM0_EMBED_DEVICE=cuda        # 没有 GPU 就写 cpu（首次加载会慢）

# --- 向量库：postgres + pgvector ---
MEM0_PG_HOST=127.0.0.1
MEM0_PG_PORT=5432
MEM0_PG_DB=mem0
MEM0_PG_USER=mem0
MEM0_PG_PASSWORD=change-me-db-password
MEM0_COLLECTION=memories

# --- 默认身份 ---
MEM0_DEFAULT_USER=bot

# 模型下载走国内镜像（境外网络可删掉这行）
HF_ENDPOINT=https://hf-mirror.com
